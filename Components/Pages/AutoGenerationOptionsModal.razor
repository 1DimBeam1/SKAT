@* AutoGenerationOptionsModal.razor *@
@rendermode InteractiveServer

@if (IsVisible)
{
    <div class="modal-overlay" @onclick="CloseModalAndReset">
        <div class="modal-content auto-gen-modal-content" @onclick:stopPropagation="true">
            <h4>Опции автоматической генерации</h4>

            <div class="form-group">
                <label for="numTasks">Количество генерируемых заданий:</label>
                <input type="number" id="numTasks" @bind="Options.NumberOfTasksToGenerate" min="1" max="100" />
            </div>

            @if (InputVariablesForGeneration != null && InputVariablesForGeneration.Any())
            {
                <h5>Настройка генерации для переменных:</h5>
                foreach (var varName in InputVariablesForGeneration)
                {
                    var currentVarConfig = GetVariableConfig(varName);

                    <div class="variable-config-group">
                        <label class="variable-name-label">@varName:</label>
                        <select @onchange="(e) => UpdateVariableGenType(varName, e.Value.ToString())">
                            <option value="@VariableGenType.Fixed" selected="@(currentVarConfig.Type == VariableGenType.Fixed)">Фиксированное</option>
                            <option value="@VariableGenType.Random" selected="@(currentVarConfig.Type == VariableGenType.Random)">Случайное</option>
                            <option value="@VariableGenType.Boundary" selected="@(currentVarConfig.Type == VariableGenType.Boundary)">Граничные</option>
                        </select>

                        @if (currentVarConfig.Type == VariableGenType.Fixed)
                        {
                            <div class="sub-options">
                                <label for="@($"fixedValue_{varName}")">Значение:</label>
                                <input type="text" id="@($"fixedValue_{varName}")" @bind="currentVarConfig.FixedValue" @bind:event="oninput" placeholder="1,2,3,4,5" />
                            </div>
                        }
                        else if (currentVarConfig.Type == VariableGenType.Boundary)
                        {
                            <div class="sub-options">
                                <label for="@($"boundaryMin_{varName}")">От:</label>
                                <input type="number" id="@($"boundaryMin_{varName}")" @bind="currentVarConfig.MinValue" @bind:event="oninput" />
                                <label for="@($"boundaryMax_{varName}")">До:</label>
                                <input type="number" id="@($"boundaryMax_{varName}")" @bind="currentVarConfig.MaxValue" @bind:event="oninput" />
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <p><em>Нет доступных переменных для настройки генерации.</em></p>
            }

            <div class="modal-actions">
                <button class="modal-btn btn-secondary" @onclick="CloseModalAndReset">Закрыть</button>
                <button class="modal-btn btn-primary" @onclick="Generate">Сгенерировать</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public List<string> InputVariablesForGeneration { get; set; } = new List<string>();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<AutoGenerationConfig> OnGenerate { get; set; }

    public AutoGenerationConfig Options { get; set; } = new AutoGenerationConfig();

    protected override void OnParametersSet()
    {
        // При каждом показе модального окна (или изменении параметров)
        // инициализируем конфигурации переменных, если они еще не существуют.
        if (IsVisible && InputVariablesForGeneration != null)
        {
            bool configChanged = false;
            foreach (var varName in InputVariablesForGeneration)
            {
                if (!Options.VariableConfigs.Any(vc => vc.VariableName == varName))
                {
                    Options.VariableConfigs.Add(new VariableGenerationSetting { VariableName = varName });
                    configChanged = true;
                }
            }
            // Удаляем конфиги для переменных, которых больше нет во входных
            var removedConfigs = Options.VariableConfigs
                .Where(vc => !InputVariablesForGeneration.Contains(vc.VariableName))
                .ToList();
            if (removedConfigs.Any())
            {
                foreach (var removed in removedConfigs)
                {
                    Options.VariableConfigs.Remove(removed);
                }
                configChanged = true;
            }

            if (configChanged)
            {
                // StateHasChanged(); // Может понадобиться, если Blazor не отлавливает изменения в списке
            }
        }
    }


    private VariableGenerationSetting GetVariableConfig(string varName)
    {
        var config = Options.VariableConfigs.FirstOrDefault(vc => vc.VariableName == varName);
        if (config == null) // Этого не должно происходить после OnParametersSet
        {
            config = new VariableGenerationSetting { VariableName = varName };
            Options.VariableConfigs.Add(config);
        }
        return config;
    }

    private void UpdateVariableGenType(string varName, string typeStr)
    {
        var config = GetVariableConfig(varName);
        if (Enum.TryParse<VariableGenType>(typeStr, out var genType))
        {
            config.Type = genType;
        }
    }

    private async Task CloseModalAndReset()
    {
        // Не сбрасываем Options здесь, т.к. пользователь может захотеть снова открыть с теми же настройками
        await OnClose.InvokeAsync();
    }

    private async Task Generate()
    {
        // Здесь можно добавить валидацию Options перед отправкой
        Console.WriteLine($"Генерация с опциями: {Options.NumberOfTasksToGenerate} заданий.");
        foreach (var vc in Options.VariableConfigs)
        {
            Console.WriteLine($"Var: {vc.VariableName}, Type: {vc.Type}, Fixed: {vc.FixedValue}, Min: {vc.MinValue}, Max: {vc.MaxValue}");
        }
        await OnGenerate.InvokeAsync(Options);
        await CloseModalAndReset();
    }

    // Классы для конфигурации
    public class AutoGenerationConfig
    {
        public int NumberOfTasksToGenerate { get; set; } = 1;
        public List<VariableGenerationSetting> VariableConfigs { get; set; } = new List<VariableGenerationSetting>();
    }

    public class VariableGenerationSetting
    {
        public string VariableName { get; set; } = string.Empty;
        public VariableGenType Type { get; set; } = VariableGenType.Fixed;
        public string? FixedValue { get; set; }
        public int? MinValue { get; set; } // Для числовых границ
        public int? MaxValue { get; set; } // Для числовых границ
                                           // Можно добавить другие поля для случайной генерации (тип данных, диапазон строк и т.д.)
    }

    public enum VariableGenType
    {
        Fixed,
        Random,
        Boundary
    }
}