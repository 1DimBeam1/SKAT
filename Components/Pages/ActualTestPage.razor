@* Componenta/Page/ActualTestPage.razor *@
@page "/actual-test/{SessionId:int}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject SKAT_Interface.Data.DbUsersContext DbUsersContext
@inject SKAT_Interface.Data.DbTaskContext DbTaskContext
@inject ProtectedSessionStorage ProtectedSessionStore
@inject EvaluationApiService EvaluationService
@inject AuthenticationStateProvider AuthStateProvider

@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.EntityFrameworkCore
@using System.Linq
@implements IDisposable


<PageTitle>Прохождение Тестирования</PageTitle>

<div class="atp-container">
    @if (isLoadingInitialData)
    {
        <div class="ptp-loading-indicator">
            <p>Загрузка данных сессии...</p>
            @* Можно добавить спиннер: <div class="spinner-border text-light" role="status"><span class="visually-hidden">Загрузка...</span></div> *@
        </div>
    }
    else if (hasLoadingError)
    {
        <div class="ptp-loading-indicator">
            <p class="text-danger">@loadingErrorMessage</p>
            <button class="ptp-button ptp-button-back" @onclick="GoBackToSessions">Вернуться к списку сессий</button>
        </div>
    }
    else
    {
        <!-- Верхняя строка с заголовками колонок -->
        <div class="atp-header-row">
            <div class="atp-header-solution">Решение (@(currentTaskIndex + 1) из @sessionTasks.Count)</div>
            <div class="atp-header-task">Задание: @(currentTask?.Name ?? "N/A")</div>
            <div class="atp-header-info">@sessionTitle</div>
        </div>

        <!-- Основная область контента -->
        <div class="atp-main-content">
            <!-- Левая Колонка (Решение) -->
            <div class="atp-solution-column">
                <div class="atp-current-step-info">
                    <div class="atp-step-description">
                        @((MarkupString)InitialStateDescription)
                    </div>

                    @if (StepZeroUserInputs.Any())
                    {
                        <div class="atp-step0-input-fields">
                            <div class="atp-block-label-inline">Введите недостающие значения для Шага 0:</div>
                            @foreach (var userInput in StepZeroUserInputs)
                            {
                                <div class="atp-variable-input-container">
                                    <label class="atp-variable-label">@userInput.Label</label>
                                    @if (userInput.IsArray && !userInput.IsTwoDimensional) // Одномерный массив
                                    {
                                        <div class="atp-array-input-cells">
                                            @for (int i = 0; i < userInput.ArrayLength; i++)
                                            {
                                                var cellIndex = i;
                                                <input type="text" class="atp-array-cell"
                                                       placeholder="эл. @(cellIndex + 1)"
                                                       value="@userInput.ArrayCellValues[cellIndex]"
                                                       @oninput="@(async (ChangeEventArgs e) => { userInput.ArrayCellValues[cellIndex] = e.Value?.ToString(); await HandleInputChange(); })" />
                                            }
                                            @* Кнопки +/- УДАЛЕНЫ *@
                                        </div>
                                    }
                                    else if (userInput.IsArray && userInput.IsTwoDimensional)
                                    {
                                        <div class="atp-2d-array-input-cells">
                                            @* Здесь будет разметка для двумерного массива (таблица или вложенные div) *@
                                            <span>(Отображение 2D массива пока не реализовано в UI)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <input type="text" class="atp-single-value-input"
                                               value="@userInput.CurrentValue"
                                               @oninput="@(async (ChangeEventArgs e) => { userInput.CurrentValue = e.Value?.ToString(); await HandleInputChange(); })"
                                               placeholder="@userInput.PlaceholderText" />
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="atp-step-adder-buttons">
                    @if (currentTask != null && currentTask.AlgorithmSteps.Any(s => s.StepNumber != 0))
                    {
                        @foreach (var algoStep in currentTask.AlgorithmSteps.Where(s => s.StepNumber != 0))
                        {
                            <button class="atp-add-step-button" @onclick="() => AddStepInstanceBasedOnAlgorithmStep(algoStep)">
                                @algoStep.Title
                            </button>
                        }
                    }
                    else if (currentTask != null)
                    {
                        <p><em>Нет доступных интерактивных шагов для этого задания.</em></p>
                    }
                </div>

                <div class="atp-displayed-steps-area">
                    @if (!DisplayedStepInstances.Any() && (currentTask?.AlgorithmSteps.All(s => s.StepNumber == 0) ?? true))
                    {
                        <div class="atp-no-steps-placeholder">
                            @if (currentTask != null && currentTask.AlgorithmSteps.Any(s => s.StepNumber != 0))
                            {
                                <span>Нажмите на кнопку "@(currentTask.AlgorithmSteps.Where(s => s.StepNumber != 0).FirstOrDefault()?.Title ?? "Шаг")", чтобы добавить поля для ввода.</span>
                            }
                            else
                            {
                                <span>Нет интерактивных шагов для добавления.</span>
                            }
                        </div>
                    }
                    @foreach (var instance in DisplayedStepInstances)
                    {
                        <div class="atp-step-instance-container @GetInstanceStatusClass(instance.Status)" @key="instance.InstanceId">
                            <div class="atp-instance-header">
                                <div class="atp-instance-title">
                                    Шаг @instance.DisplayOrder:
                                </div>
                                <div class="atp-instance-description">
                                    @instance.Description
                                    (@(currentTask?.AlgorithmSteps.FirstOrDefault(s => s.StepNumber == instance.OriginalStepNumber)?.Title ?? $"Ориг. Шаг {instance.OriginalStepNumber}"))
                                </div>

                                @* Иконка статуса и ошибки *@
                                <div class="atp-instance-status-icons">
                                    @if (instance.Status == StepStatus.Incorrect && !string.IsNullOrEmpty(instance.ErrorMessageForUI))
                                    {
                                        <span class="atp-status-icon error-icon" title="@instance.ErrorMessageForUI">ℹ️</span>
                                        @* Вместо "ℹ️" можно использовать SVG иконку или иконочный шрифт *@
                                    }
                                    else if (instance.Status == StepStatus.Correct)
                                    {
                                        <span class="atp-status-icon correct-icon">✔️</span>
                                    }
                                    else if (instance.Status == StepStatus.Pending || instance.Status == StepStatus.Submitted)
                                    {
                                        <span class="atp-status-icon pending-icon">⏳</span>
                                    }
                                    @* Можно добавить иконку для NotChecked, если нужно *@
                                </div>

                                <button class="atp-remove-step-button" title="Удалить этот шаг" @onclick="async () => await RemoveStepInstance(instance)">
                                    ×
                                </button>
                            </div>
                            <div class="atp-instance-input-fields">
                                @foreach (var userInput in instance.UserInputs)
                                {
                                    <div class="atp-variable-input-container">
                                        <label class="atp-variable-label">@userInput.Label</label>
                                        @if (userInput.IsArray && !userInput.IsTwoDimensional) // Одномерный массив
                                        {
                                            <div class="atp-array-input-cells">
                                                @for (int i = 0; i < userInput.ArrayLength; i++)
                                                {
                                                    var cellIndex = i;
                                                    <input type="text" class="atp-array-cell"
                                                           placeholder="эл. @(cellIndex+1)"
                                                           value="@userInput.ArrayCellValues[cellIndex]"
                                                           @oninput="@(async (ChangeEventArgs e) => { userInput.ArrayCellValues[cellIndex] = e.Value?.ToString(); await HandleInputChange(); })" />
                                                }
                                                @* Кнопки +/- УДАЛЕНЫ *@
                                            </div>
                                        }
                                        else if (userInput.IsArray && userInput.IsTwoDimensional)
                                        {
                                            <div class="atp-2d-array-input-cells">
                                                <span>(Отображение 2D массива пока не реализовано в UI)</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <input type="text" class="atp-single-value-input"
                                                   value="@userInput.CurrentValue"
                                                   @oninput="@(async (ChangeEventArgs e) => { userInput.CurrentValue = e.Value?.ToString(); await HandleInputChange(); })"
                                                   placeholder="@userInput.PlaceholderText" />
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Средняя Колонка (Задание) -->
            <div class="atp-task-column">
                <div class="atp-task-formulation">
                    <div class="atp-block-label">Задание:</div>
                    <textarea readonly>@currentTaskFormulation</textarea>
                </div>
                <div class="atp-task-image">
                    <div class="atp-block-label">Описание алгоритма:</div>
                    <div class="atp-image-placeholder">
                        @if (!string.IsNullOrEmpty(taskImageUrl))
                        {
                            <img src="@taskImageUrl" alt="Описание алгоритма для @(currentTask?.Name)" />
                        }
                        else
                        {
                            <span>(Нет изображения для этого алгоритма)</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Правая Колонка (Информация) -->
            <div class="atp-info-column">
                <div class="atp-info-block atp-time-remaining">
                    <div class="atp-block-label">Времени осталось:</div>
                    <div class="atp-timer-display">@timeRemainingDisplay</div>
                </div>
                <div class="atp-info-block atp-algorithm-steps-hint">
                    <div class="atp-block-label">Шаги алгоритма (@(currentTask?.AlgorithmName ?? "")):</div>
                    @if (currentTask != null && currentTask.AlgorithmSteps.Any())
                    {
                        <div class="atp-algorithm-step-list">
                            @foreach (var step in currentTask.AlgorithmSteps)
                            {
                                <div class="atp-algorithm-step-item" title="@step.Description">
                                    @step.Title
                                </div>
                            }
                        </div>
                    }
                    else if (currentTask != null)
                    {
                        <div class="atp-no-hints-placeholder">(Для этого алгоритма не определены шаги)</div>
                    }
                    else
                    {
                        <div class="atp-no-hints-placeholder">(Задание не выбрано)</div>
                    }
                </div>
                <div class="atp-info-block atp-session-tasks-list">
                    <div class="atp-block-label">Список заданий в сессии:</div>
                    <div class="atp-session-task-items">
                        @if (sessionTasks.Any())
                        {
                            @foreach (var taskItem in sessionTasks.Select((task, index) => new { task, index }))
                            {
                                <div class="atp-session-task-item @(taskItem.task.IsCurrent ? "current" : "")" @onclick="() => SetCurrentTask(taskItem.index)">
                                    @(taskItem.index + 1). @taskItem.task.Name
                                </div>
                            }
                        }
                        else
                        {
                            <div>Нет заданий в этой сессии.</div>
                        }
                    </div>
                </div>
                <div class="atp-action-buttons-footer">
                    @* Обернем кнопки в div для лучшего управления макетом *@
                    @if (currentTestMode == PreTestPage.TestMode.Training)
                    {
                        <button class="atp-button atp-button-check" @onclick="CheckCurrentTaskSolutionAsync" disabled="@(!sessionTasks.Any() || hasLoadingError || isLoadingInitialData || IsCheckingSolution)">
                            @if (IsCheckingSolution)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            Проверить
                        </button>
                    }
                    <button class="atp-button atp-button-next" @onclick="GoToNextTaskOrFinishSession" disabled="@(!sessionTasks.Any() || hasLoadingError || isLoadingInitialData || IsCheckingSolution)">
                        @nextButtonText
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "mode")]
    public string? ModeString { get; set; }

    private bool IsCheckingSolution = false;

    // --- Состояние загрузки и ошибок ---
    private bool isLoadingInitialData = true;
    private bool hasLoadingError = false;
    private string loadingErrorMessage = string.Empty;

    private string AllTasksStateKey => $"{SessionStateKeyBase}_AllTasksStates";
    private AllTasksSessionState currentSessionFullState = new AllTasksSessionState();
    private EvaluationResponseDto? lastEvaluationResult;
    // --- Данные сессии и заданий ---
    private string sessionTitle = "Загрузка...";
    private TimeSpan sessionTimeLimit;
    private List<SessionTaskInfo> sessionTasks = new List<SessionTaskInfo>();
    private SessionTaskInfo? currentTask;
    private int currentTaskIndex = 0; // Будет восстанавливаться

    // --- Данные текущего задания ---
    private string currentTaskFormulation = "Загрузка описания задания...";
    private string? taskImageUrl = null;
    private string InitialStateDescription { get; set; } = string.Empty; // Для Шага 0 (текст + известные значения)
    private List<VariableInputData> StepZeroUserInputs { get; set; } = new List<VariableInputData>(); // Поля для ввода Шага 0

    // --- Режим тестирования и подсказки ---
    private PreTestPage.TestMode currentTestMode = PreTestPage.TestMode.Training;
    private bool showHints = true;
    private string currentHint = "Здесь будет подсказка..."; // TODO: Загружать подсказки для задания

    // --- Таймер ---
    private string timeRemainingDisplay = "00:00:00";
    private System.Threading.Timer? _timer;
    private int _totalSecondsRemaining; // Будет восстанавливаться

    // --- Интерактивные шаги ---
    private List<ActiveStepInstance> DisplayedStepInstances { get; set; } = new List<ActiveStepInstance>();

    // --- Текст кнопки "Далее" ---
    private string nextButtonText = "Следующее задание";

    // --- Ключи для SessionStorage ---
    private string SessionStateKeyBase => $"TestSessionState_{SessionId}";
    private string CurrentTaskStateKey => $"{SessionStateKeyBase}_Task_{currentTask?.TestId ?? 0}"; // Зависит от текущего задания
    private string CurrentGlobalTaskIndexKey => $"{SessionStateKeyBase}_GlobalTaskIndex";
    private string TimeRemainingKey => $"{SessionStateKeyBase}_TimeRemaining";

    // --- Модель для сохранения состояния в SessionStorage ---
    public class TestSessionTaskState // Состояние для ОДНОГО задания
    {
        public List<ActiveStepInstance> DisplayedSteps { get; set; } = new List<ActiveStepInstance>();
        public List<VariableInputData> StepZeroInputs { get; set; } = new List<VariableInputData>();
    }

    // --- ViewModel классы (остаются без изменений из предыдущего ответа) ---
    public enum StepStatus { Pending, Correct, Incorrect, NotChecked, Submitted }
    public class VariableTemplate { public string Name { get; set; } = string.Empty; public string Label => $"{Name} ="; public bool IsWide { get; set; } public string PlaceholderText { get; set; } = ""; }
    // StepTemplateModel можно удалить, если кнопки генерируются из AlgorithmStepInfo
    // public class StepTemplateModel { public int StepNumber { get; set; } public string Title => $"Шаг {StepNumber}."; public List<VariableTemplate> Variables { get; set; } = new List<VariableTemplate>(); public string InitialDescription { get; set; } = string.Empty; }
    public class AllTasksSessionState
    {
        // Словарь: TestId -> Состояние этого задания
        public Dictionary<int, TestSessionTaskState> TaskStates { get; set; } = new Dictionary<int, TestSessionTaskState>();
        public int CurrentGlobalTaskIndex { get; set; } = 0;
        public int TimeRemainingSeconds { get; set; } = 0;
    }

    public class ActiveStepInstance : IEquatable<ActiveStepInstance>
    {
        public Guid InstanceId { get; } // Убираем = Guid.NewGuid();
        public ActiveStepInstance() { InstanceId = Guid.NewGuid(); } // Конструктор по умолчанию
        public ActiveStepInstance(Guid id) { InstanceId = id; }
        public int OriginalStepNumber { get; set; } // Номер шага из шаблона/алгоритма
        public string Description { get; set; } = string.Empty;
        public List<VariableInputData> UserInputs { get; set; } = new List<VariableInputData>();
        public StepStatus Status { get; set; } = StepStatus.NotChecked;

        // --- НОВОЕ СВОЙСТВО ---
        public int DisplayOrder { get; set; } // Порядковый номер отображения
        public string? ErrorMessageForUI { get; set; }
        public bool Equals(ActiveStepInstance? other)
        {
            if (other is null) return false;
            return InstanceId.Equals(other.InstanceId);
        }
        public override bool Equals(object? obj) => Equals(obj as ActiveStepInstance);
        public override int GetHashCode() => InstanceId.GetHashCode();
    }
    public class VariableInputData // Данные для конкретного поля ввода в UI
    {
        public string Name { get; set; } = string.Empty;
        public string Label => $"{Name} =";
        public string? CurrentValue { get; set; } // Для не-массивов или если массив вводится как строка "1,2,3"

        public bool IsArray { get; set; } // Флаг, что это массив
        // Для одномерного массива:
        public List<string?> ArrayCellValues { get; set; } = new List<string?>();
        public int ArrayLength { get; set; } // Фиксированная длина одномерного массива

        // Для двумерного массива (если будете реализовывать):
        public List<List<string?>>? TwoDArrayCellValues { get; set; }
        public int ArrayRows { get; set; }
        public int ArrayCols { get; set; }
        public bool IsTwoDimensional { get; set; }

        public int MaxCellsPerDimension { get; set; } = 15; // Общее ограничение на размерность
        public string PlaceholderText { get; set; } = "";
        public StepStatus Status { get; set; } = StepStatus.NotChecked;
        public string? ErrorMessageForUI { get; set; }
    }

    public class TrackedVariableInfo
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty; // e.g., "int", "string", "int[]", "array", "array[rows,cols]"
        public string Label => $"{Name} =";
        public bool IsArrayType => Type.Contains("[]") || Type.StartsWith("array", StringComparison.OrdinalIgnoreCase);

        // Размеры для массивов (могут быть определены из VarType или TestInputData)
        public int ArrayDimension1Size { get; set; } = 0; // Для одномерного - длина, для двумерного - строки
        public int ArrayDimension2Size { get; set; } = 0; // Для двумерного - столбцы (0 если одномерный)
        public bool IsTwoDimensionalArray => IsArrayType && ArrayDimension2Size > 0;

        public string PlaceholderTextSingle => IsArrayType ? "эл." : "";
    }

    public class AlgorithmStepInfo // Используется при загрузке из БД
    {
        public int StepNumber { get; set; }
        public string Description { get; set; } = string.Empty;
        public string Title => $"Шаг {StepNumber}";
        public List<TrackedVariableInfo> VariablesToTrack { get; set; } = new List<TrackedVariableInfo>();
    }

    public class SessionTaskInfo
    {
        public int TestId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string? AlgorithmImagePath { get; set; }
        public bool IsCurrent { get; set; }
        public int AlgorithmId { get; set; }
        public string AlgorithmName { get; set; } = string.Empty;
        public List<AlgorithmStepInfo> AlgorithmSteps { get; set; } = new List<AlgorithmStepInfo>();
        public string TaskInitialStateDescription { get; set; } = string.Empty; // Сформированное описание Шага 0
        public Dictionary<string, string> InputDataValues { get; set; } = new Dictionary<string, string>(); // TestInputData для этого теста
    }

    // --- Методы жизненного цикла ---
    protected override async Task OnInitializedAsync()
    {
        // Загрузка данных перенесена в OnParametersSetAsync, так как зависит от SessionId
        await Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoadingInitialData = true;
        hasLoadingError = false;
        loadingErrorMessage = string.Empty;
        // StateHasChanged(); // Вызовется в конце или при await

        ParseModeFromQueryString();
        showHints = currentTestMode == PreTestPage.TestMode.Training;

        // Загружаем основные данные сессии и заданий, только если они еще не загружены или SessionId изменился
        // Для простоты будем перезагружать, если SessionId изменился (хотя он параметр пути и не должен меняться без перезагрузки компонента)
        // Но если это возможно, нужна более сложная логика отслеживания.
        // Пока что, если sessionTasks пуст, значит это первая загрузка.
        if (!sessionTasks.Any() || (currentTask != null && currentTask.TestId == 0)) // Проверка, что данные еще не загружены
        {
            await LoadSessionAndTasksDataAsync();
        }


        if (!hasLoadingError)
        {
            await RestoreFullSessionStateAsync(); // Восстанавливаем индекс задания и время

            if (sessionTasks.Any())
            {
                // Устанавливаем текущее задание (это также вызовет RestoreTaskSpecificState внутри себя)
                await SetCurrentTask(currentSessionFullState.CurrentGlobalTaskIndex, true); // currentTaskIndex был восстановлен
            }
            else
            {
                currentTaskFormulation = "В этой сессии нет заданий.";
                nextButtonText = "Вернуться к списку сессий";
            }

            // Таймер
            if (_timer == null && currentSessionFullState.TimeRemainingSeconds > 0)
            {
                InitializeAndStartTimer(false); // false - используем восстановленное время
            }
            else if (_timer == null && sessionTimeLimit > TimeSpan.Zero && currentSessionFullState.TimeRemainingSeconds <= 0)
            {
                InitializeAndStartTimer(true); // true - используем полное время сессии
            }
            else if (sessionTimeLimit == TimeSpan.Zero)
            {
                timeRemainingDisplay = "Без ограничений";
            }
        }

        isLoadingInitialData = false;
        //await base.OnParametersSetAsync();
    }

    private void ParseModeFromQueryString()
    {
        if (!string.IsNullOrEmpty(ModeString) && Enum.TryParse<PreTestPage.TestMode>(ModeString, true, out var parsedMode))
        {
            currentTestMode = parsedMode;
        }
        else
        {
            currentTestMode = PreTestPage.TestMode.Training; // По умолчанию
        }
    }

    private async Task LoadSessionAndTasksDataAsync()
    {
        // ... (код LoadSessionAndTasksDataAsync из предыдущего ответа, он корректен) ...
        // ВАЖНО: убедитесь, что внутри него при маппинге в SessionTaskInfo
        // для TaskInitialStateDescription и AlgorithmSteps.VariablesToTrack
        // вы используете `currentTestInputData` для определения, какие переменные уже имеют значения.
        // И что `TaskInitialStateDescription` формируется правильно с учетом этого.
        // Также, что `InputDataValues` сохраняется в `SessionTaskInfo`.
        try
        {
            var session = await DbUsersContext.Sessions.FirstOrDefaultAsync(s => s.SessionId == SessionId);
            if (session == null) { loadingErrorMessage = $"Сессия {SessionId} не найдена."; hasLoadingError = true; return; }
            sessionTitle = $"Тестирование: {session.SessionType ?? "N/A"} (ID: {SessionId})";
            sessionTimeLimit = session.Time;

            var testIdsInSession = await DbUsersContext.SessionTests
                                        .Where(st => st.SessionId == SessionId)
                                        .Select(st => st.TestId).ToListAsync();
            if (!testIdsInSession.Any()) { sessionTasks = new List<SessionTaskInfo>(); currentTaskFormulation = "В этой сессии нет заданий."; return; }

            var allInputDataForSessionTests = await DbTaskContext.Testinputdata
                                                .Where(tid => testIdsInSession.Contains(tid.TestId)).ToListAsync();

            var testsFromDb = await DbTaskContext.Tests
                .Include(t => t.Algo).ThenInclude(a => a.Algorithmsteps).ThenInclude(astep => astep.Trackedvariables)
                .Where(t => testIdsInSession.Contains(t.TestId)).ToListAsync();

            sessionTasks = testsFromDb.Select(t =>
            {
                var currentTestInputDataMap = allInputDataForSessionTests
                                           .Where(tid => tid.TestId == t.TestId)
                                           .ToDictionary(tid => tid.VarName, tid => tid); // Словарь Testinputdatum

                var algoSteps = t.Algo?.Algorithmsteps
                .OrderBy(s => s.AlgoStep)
                .Select(s =>
                {
                    var stepInfo = new AlgorithmStepInfo
                        {
                            StepNumber = s.AlgoStep,
                            Description = s.Description,
                            VariablesToTrack = s.Trackedvariables
                                .OrderBy(tv => tv.Sequence)
                                .Select(tv =>
                                {
                                    var trackedVarInfo = new TrackedVariableInfo
                                    {
                                        Name = tv.VarName,
                                        Type = tv.VarType // e.g., "int", "int[]", "array", "array[rows,cols]"
                                    };

                                // Пытаемся определить размер массива из Testinputdata или из типа
                                    if (trackedVarInfo.IsArrayType)
                                    {
                                        if (currentTestInputDataMap.TryGetValue(tv.VarName, out var inputDataForVar))
                                        {
                                        // Парсим VarValue для определения размеров
                                        // Пример для одномерного: "1,2,3,4,5"
                                        // Пример для двумерного: "1,2;3,4;5,6"
                                            var parts = inputDataForVar.VarValue.Split(';');
                                            if (parts.Length > 1) // Похоже на двумерный
                                            {
                                                trackedVarInfo.ArrayDimension1Size = Math.Min(parts.Length, 15); // Кол-во строк
                                                if (parts.Length > 0)
                                                {
                                                    trackedVarInfo.ArrayDimension2Size = Math.Min(parts[0].Split(',').Length, 15); // Кол-во столбцов по первой строке
                                                }
                                            }
                                            else // Одномерный
                                            {
                                                trackedVarInfo.ArrayDimension1Size = Math.Min(parts[0].Split(',').Length, 15);
                                                trackedVarInfo.ArrayDimension2Size = 0;
                                            }
                                        }
                                        else
                                        {
                                        // Если нет входных данных, пытаемся извлечь из типа, например "int[5]" или "array[5,3]"
                                        // Это более сложный парсинг, для простоты пока оставим дефолтные значения или 0
                                        // Для примера, если тип "int[N]", то N - это размер
                                        // string typeDef = tv.VarType.ToLower();
                                        // if (typeDef.StartsWith("array[") && typeDef.EndsWith("]")) { ... парсинг ... }
                                        // else if (typeDef.EndsWith("[]")) { ... }
                                            trackedVarInfo.ArrayDimension1Size = 5; // Заглушка, если нет в TestInputData
                                        }
                                    }
                                    return trackedVarInfo;
                                }).ToList()
                        };
                    return stepInfo;
                }).ToList() ?? new List<AlgorithmStepInfo>();

                string initialStateDesc;
                var stepZero = algoSteps.FirstOrDefault(s => s.StepNumber == 0);
                if (stepZero != null)
                {
                    initialStateDesc = $"Шаг 0: {stepZero.Description}\nНачальные значения:\n";
                    if (stepZero.VariablesToTrack.Any())
                    {
                        foreach (var variable in stepZero.VariablesToTrack)
                        {
                            if (currentTestInputDataMap.TryGetValue(variable.Name, out var inputInfo))
                            {
                                initialStateDesc += $"{variable.Name} = {inputInfo.VarValue}\n";
                            }
                            else { initialStateDesc += $"{variable.Name} = (введите значение)\n"; }
                        }
                    }
                    else { initialStateDesc += "(Нет отслеживаемых переменных для Шага 0)\n"; }
                }
                else
                {
                    initialStateDesc = $"Начальное состояние для задания '{t.TestName}':\n";
                    if (currentTestInputDataMap.Any()) { foreach (var entry in currentTestInputDataMap) { initialStateDesc += $"{entry.Key} = {entry.Value.VarValue}\n"; } }
                    else { initialStateDesc += "(Входные данные не указаны)\n"; }
                }

                return new SessionTaskInfo
                    {
                        TestId = t.TestId,
                        Name = t.TestName,
                        Description = t.Description,
                        AlgorithmImagePath = t.Algo?.PicPath,
                        IsCurrent = false,
                        AlgorithmId = t.AlgoId,
                        AlgorithmName = t.Algo?.AlgoName ?? "Неизвестный алгоритм",
                        AlgorithmSteps = algoSteps,
                        InputDataValues = currentTestInputDataMap.ToDictionary(kvp => kvp.Key, kvp => kvp.Value.VarValue),
                        TaskInitialStateDescription = initialStateDesc.TrimEnd()
                    };
            }).ToList();
        }
        catch (Exception ex) { Console.WriteLine($"Ошибка загрузки: {ex.Message} \n {ex.StackTrace}"); loadingErrorMessage = "Ошибка загрузки."; hasLoadingError = true; }
    }


    private async Task RestoreGlobalStateAsync()
    {
        try
        {
            var taskIndexResult = await ProtectedSessionStore.GetAsync<int>(CurrentGlobalTaskIndexKey);
            currentTaskIndex = taskIndexResult.Success ? taskIndexResult.Value : 0;

            var timeResult = await ProtectedSessionStore.GetAsync<int>(TimeRemainingKey);
            _totalSecondsRemaining = timeResult.Success ? timeResult.Value : (int)sessionTimeLimit.TotalSeconds;
            UpdateTimeRemainingDisplay();
        }
        catch (Exception ex)
        {
