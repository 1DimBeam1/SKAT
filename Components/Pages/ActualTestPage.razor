    private async Task RestoreTaskSpecificStateAsync()
    {
        StepZeroUserInputs.Clear();
        DisplayedStepInstances.Clear();

        if (currentTask == null) return;

        try
        {
            var stateResult = await ProtectedSessionStore.GetAsync<TestSessionTaskState>(CurrentTaskStateKey);
            if (stateResult.Success && stateResult.Value != null)
            {
                StepZeroUserInputs = stateResult.Value.StepZeroInputs ?? new List<VariableInputData>();
                DisplayedStepInstances = stateResult.Value.DisplayedSteps ?? new List<ActiveStepInstance>();
                Console.WriteLine($"Состояние восстановлено для задания {currentTask.TestId}");
            }
            else // Если нет сохраненного состояния, инициализируем StepZeroInputs
            {
                InitializeStepZeroInputsForCurrentTask();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка восстановления состояния для задания {currentTask.TestId}: {ex.Message}");
            InitializeStepZeroInputsForCurrentTask(); // Инициализация при ошибке
        }
    }

    private void InitializeStepZeroInputsForCurrentTask()
    {
        StepZeroUserInputs.Clear();
        if (currentTask == null) return;

        var stepZeroTemplate = currentTask.AlgorithmSteps.FirstOrDefault(s => s.StepNumber == 0);
        if (stepZeroTemplate != null)
        {
            foreach (var variableInfo in stepZeroTemplate.VariablesToTrack)
            {
                // Переменная для Шага 0 требует ввода, если ее нет в TestInputData ИЛИ если ее значение там было пустым/специальным маркером
                // Для простоты, если ее нет в InputDataValues (которые мы сохранили в SessionTaskInfo)
                if (!currentTask.InputDataValues.ContainsKey(variableInfo.Name))
                {
                    var inputDataItem = new VariableInputData
                        {
                            Name = variableInfo.Name,
                            IsArray = variableInfo.IsArrayType,
                            IsTwoDimensional = variableInfo.IsTwoDimensionalArray,
                        };

                    if (variableInfo.IsArrayType)
                    {
                        if (variableInfo.IsTwoDimensionalArray)
                        {
                            // Логика для двумерного (пока не используется в разметке)
                            inputDataItem.ArrayRows = Math.Max(1, variableInfo.ArrayDimension1Size); // хотя бы 1, если размер 0
                            inputDataItem.ArrayCols = Math.Max(1, variableInfo.ArrayDimension2Size);
                            inputDataItem.TwoDArrayCellValues = new List<List<string?>>();
                            for (int r = 0; r < inputDataItem.ArrayRows; r++)
                            {
                                inputDataItem.TwoDArrayCellValues.Add(new List<string?>(new string?[inputDataItem.ArrayCols]));
                            }
                        }
                        else // Одномерный
                        {
                            inputDataItem.ArrayLength = Math.Max(1, variableInfo.ArrayDimension1Size); // хотя бы 1
                            inputDataItem.ArrayCellValues = new List<string?>(new string?[inputDataItem.ArrayLength]);
                        }
                    }
                    StepZeroUserInputs.Add(inputDataItem);
                }
            }
        }
    }

    private void SaveCurrentTaskStateToFullState()
    {
        if (currentTask == null) return;
        if (!currentSessionFullState.TaskStates.ContainsKey(currentTask.TestId))
        {
            currentSessionFullState.TaskStates[currentTask.TestId] = new TestSessionTaskState();
        }
        currentSessionFullState.TaskStates[currentTask.TestId].StepZeroInputs = new List<VariableInputData>(StepZeroUserInputs.Select(CloneVariableInputData));
        currentSessionFullState.TaskStates[currentTask.TestId].DisplayedSteps = new List<ActiveStepInstance>(DisplayedStepInstances.Select(CloneActiveStepInstance));
    }

