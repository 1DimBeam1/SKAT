        // if (!canProceed && currentTestMode == PreTestPage.TestMode.Control) {
        //     // Показать сообщение, что нужно исправить ошибки
        //     return;
        // }


        await SaveTaskSpecificStateAsync(); // Сохраняем состояние (включая обновленные статусы шагов)

        if (currentTaskIndex < sessionTasks.Count - 1)
        {
            currentTaskIndex++;
            await SaveGlobalStateAsync();
            SetCurrentTask(currentTaskIndex); // Загрузит новое задание и его состояние
        }
