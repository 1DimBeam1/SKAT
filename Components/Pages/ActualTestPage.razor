    private async Task RemoveStepInstance(ActiveStepInstance instanceToRemove)
    {
        if (instanceToRemove == null) return;

        bool removed = DisplayedStepInstances.Remove(instanceToRemove);
        if (removed)
        {
            ReindexDisplayedSteps(); // Переиндексируем оставшиеся шаги
            await SaveTaskSpecificStateAsync(); // Сохраняем состояние после удаления и переиндексации
            StateHasChanged();
            Console.WriteLine($"Удален экземпляр шага: {instanceToRemove.Description} (ID: {instanceToRemove.InstanceId})");
        }
            if (DisplayedStepInstances.Remove(instanceToRemove))
    {
        ReindexDisplayedSteps();
        SaveCurrentTaskStateToFullState();
        await SaveFullSessionStateAsync();
        StateHasChanged();
    }
    }

    private void ReindexDisplayedSteps()
    {
        for (int i = 0; i < DisplayedStepInstances.Count; i++)
        {
            DisplayedStepInstances[i].DisplayOrder = i + 1;
        }
    }

    private async Task ProcessSessionCompletion(string reason)
    {
        Console.WriteLine($"Завершение сессии {SessionId}. Причина: {reason}.");
        _timer?.Dispose(); _timer = null;
        IsCheckingSolution = true; // Можно установить, чтобы UI не реагировал
        StateHasChanged();

        float? scoreToSave = null;
        if (lastEvaluationResult?.Score.HasValue ?? false)
        {
            scoreToSave = lastEvaluationResult.Score.Value;
            Console.WriteLine($"Итоговый Score: {scoreToSave}");
        }
        else if (reason == "timeout" || reason == "completed_no_data")
        {
            scoreToSave = 0f; // или другое значение по умолчанию
            Console.WriteLine($"Сессия завершена по причине '{reason}', итоговый Score не получен от API, устанавливается {scoreToSave}.");
        }
        else
        {
            Console.WriteLine("Итоговый Score не получен от API.");
        }


        if (scoreToSave.HasValue)
        {
            try
            {
                await ProtectedSessionStore.SetAsync($"SessionScore_{SessionId}", scoreToSave.Value);
            }
            catch (Exception ex) { Console.WriteLine($"Ошибка сохранения Score в sessionStorage: {ex.Message}"); }
        }

        // TODO: Сохранить итог сессии (UserId, SessionId, scoreToSave, reason, DateTime.UtcNow) в DbUsersContext

        await ClearAllSessionStateButResultsAsync();
        NavigationManager.NavigateTo($"/session-results/{SessionId}?reason={reason}");
    }


    private VariableInputData CloneVariableInputData(VariableInputData original)
    {
        return new VariableInputData
            {
                Name = original.Name, // Копируем Name
            // Label = original.Label, // <<< ЭТУ СТРОКУ НУЖНО УДАЛИТЬ ИЛИ ЗАКОММЕНТИРОВАТЬ
            // Label будет вычислен автоматически на основе Name
                CurrentValue = original.CurrentValue,
                IsArray = original.IsArray,
                ArrayCellValues = new List<string?>(original.ArrayCellValues ?? new List<string?>()), // Добавил ?? new List для nullable
                ArrayLength = original.ArrayLength,
                IsTwoDimensional = original.IsTwoDimensional,
                TwoDArrayCellValues = original.TwoDArrayCellValues?.Select(row => new List<string?>(row ?? new List<string?>())).ToList(), // Добавил ?? new List для nullable
                ArrayRows = original.ArrayRows,
                ArrayCols = original.ArrayCols,
                MaxCellsPerDimension = original.MaxCellsPerDimension,
                PlaceholderText = original.PlaceholderText,
                Status = original.Status,
                ErrorMessageForUI = original.ErrorMessageForUI
            };
    }
    private ActiveStepInstance CloneActiveStepInstance(ActiveStepInstance original)
    {
        // Guid генерируется заново, DisplayOrder и Status сохраняются
        return new ActiveStepInstance(original.InstanceId) // Сохраняем оригинальный ID для ключа в разметке
            {
                OriginalStepNumber = original.OriginalStepNumber,
                Description = original.Description,
                UserInputs = new List<VariableInputData>(original.UserInputs.Select(CloneVariableInputData)),
                Status = original.Status,
                DisplayOrder = original.DisplayOrder,
                ErrorMessageForUI = original.ErrorMessageForUI
            };
    }
    private async Task SaveFullSessionStateAsync()
    {
        try
        {
            SaveCurrentTaskStateToFullState(); // Сохраняем текущее задание в общий стейт перед сохранением всего
            currentSessionFullState.CurrentGlobalTaskIndex = currentTaskIndex;
            currentSessionFullState.TimeRemainingSeconds = _totalSecondsRemaining;
            await ProtectedSessionStore.SetAsync(AllTasksStateKey, currentSessionFullState);
            Console.WriteLine($"Полное состояние сессии {SessionId} сохранено.");
        }
        catch (Exception ex) { Console.WriteLine($"Ошибка сохранения полного состояния сессии: {ex.Message}"); }
    }

    private async Task RestoreFullSessionStateAsync()
    {
        try
        {
            var stateResult = await ProtectedSessionStore.GetAsync<AllTasksSessionState>(AllTasksStateKey);
            if (stateResult.Success && stateResult.Value != null)
            {
                currentSessionFullState = stateResult.Value;
                currentTaskIndex = currentSessionFullState.CurrentGlobalTaskIndex;
                _totalSecondsRemaining = currentSessionFullState.TimeRemainingSeconds;
                Console.WriteLine($"Полное состояние сессии {SessionId} восстановлено.");
            }
            else
            {
                // Начальная инициализация, если состояния нет
                currentSessionFullState = new AllTasksSessionState();
                currentTaskIndex = 0;
                _totalSecondsRemaining = (int)sessionTimeLimit.TotalSeconds; // Из загруженного времени сессии
            }
            UpdateTimeRemainingDisplay(); // Обновляем отображение времени
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка восстановления полного состояния сессии: {ex.Message}");
            currentSessionFullState = new AllTasksSessionState();
            currentTaskIndex = 0;
            _totalSecondsRemaining = (int)sessionTimeLimit.TotalSeconds;
        }
    }
    private async Task ClearAllSessionStateButResultsAsync()
    {
        try
        {
            var testIdsInSession = sessionTasks.Select(st => st.TestId).ToList(); // Берем из уже загруженных
            foreach (var testId in testIdsInSession)
            {
                await ProtectedSessionStore.DeleteAsync($"{SessionStateKeyBase}_Task_{testId}");
            }
            await ProtectedSessionStore.DeleteAsync(CurrentGlobalTaskIndexKey);
            await ProtectedSessionStore.DeleteAsync(TimeRemainingKey);
            // НЕ УДАЛЯЕМ SessionScore_{SessionId} и SessionErrors_{SessionId} здесь, их прочитает страница результатов
            Console.WriteLine($"Рабочее состояние для сессии {SessionId} очищено.");
        }
        catch (Exception ex) { Console.WriteLine($"Ошибка при очистке рабочего состояния сессии: {ex.Message}"); }
    }

    // --- Таймер ---
    private void InitializeAndStartTimer(bool useSessionTimeLimitAsInitial = true)
    {
        if (useSessionTimeLimitAsInitial || _totalSecondsRemaining <= 0) // Если нужно сбросить или время вышло/не установлено
        {
            _totalSecondsRemaining = (int)sessionTimeLimit.TotalSeconds;
        }
        UpdateTimeRemainingDisplay();
        _timer?.Dispose();
        if (_totalSecondsRemaining > 0)
        {
            _timer = new System.Threading.Timer(TimerTick, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        else if (sessionTimeLimit == TimeSpan.Zero)
        {
            timeRemainingDisplay = "Без ограничений";
        }
        else
        {
            timeRemainingDisplay = "00:00:00";
            // Если время уже вышло при инициализации, вызываем HandleTimeExpired
            if (!isLoadingInitialData) InvokeAsync(HandleTimeExpired); // Только если не идет первоначальная загрузка
        }
    }

    private async void TimerTick(object? state) // async void
    {
        bool shouldStopTimer = false;
        if (_totalSecondsRemaining > 0)
        {
            _totalSecondsRemaining--;
            UpdateTimeRemainingDisplay();
            if (_totalSecondsRemaining % 10 == 0) // Периодическое сохранение
            {
                await SaveGlobalStateAsync(); // Сохраняем только время и индекс задания
            }
        }
        else
        {
            _totalSecondsRemaining = 0;
            UpdateTimeRemainingDisplay();
            shouldStopTimer = true;
        }

        await InvokeAsync(StateHasChanged);

        if (shouldStopTimer)
        {
            _timer?.Dispose();
            _timer = null;
            await InvokeAsync(HandleTimeExpired);
        }
    }

    private void UpdateTimeRemainingDisplay()
    {
        if (sessionTimeLimit == TimeSpan.Zero)
        {
            timeRemainingDisplay = "Без ограничений";
            return;
        }
        TimeSpan ts = TimeSpan.FromSeconds(_totalSecondsRemaining);
        timeRemainingDisplay = $"{Math.Floor(ts.TotalHours):00}:{ts.Minutes:D2}:{ts.Seconds:D2}";
    }

    private async Task HandleTimeExpired()
    {
        Console.WriteLine("Время сессии истекло!");
        // Если нужно отправить последние данные на оценку при истечении времени
        // await CheckCurrentTaskSolutionAsync(); // Раскомментируйте, если это требуется

        // Сохраняем последний известный Score (или устанавливаем 0, если не было проверок)
        // (это должно произойти в CheckCurrentTaskSolutionAsync, если он вызывался)
        // Если нет, то на странице результатов Score может быть null или 0.
        // await ProtectedSessionStore.SetAsync($"SessionScore_{SessionId}", _totalSecondsRemaining > 0 ? (float?)null : 0f); // Пример

        await ProcessSessionCompletion("timeout");
    }
