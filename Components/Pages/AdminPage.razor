@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
<link href="css/AdminPageCSS.css" rel="stylesheet" />

<PageTitle>Тестовые сессии</PageTitle>

<div class="admin-main-container">
    @* Изменено имя класса для избежания конфликтов, если main-container где-то еще используется *@
    <!-- Правая колонка (Основной контент) -->
    <div class="admin-main-content">
        <div class="search-bar">
            <input type="text" placeholder="Поиск сессии..." @bind="searchTerm" @bind:event="oninput" />
        </div>
        <div class="session-list">
            @if (filteredSessions == null)
            {
                <p><em>Загрузка...</em></p>
            }
            else if (!filteredSessions.Any())
            {
                <p><em>Сессии не найдены.</em></p>
            }
            else
            {
                @foreach (var session in filteredSessions)
                {
                    <div class="session-item">
                        <div class="session-name">@session.Name</div>
                        <div class="session-action">
                            @switch (session.Status)
                            {
                                case SessionStatus.Completed:
                                    <button class="btn-results" @onclick="() => ShowResults(session.Id)">Результаты</button>
                                    break;
                                case SessionStatus.NotStarted:
                                    <button class="btn-start" @onclick="() => StartSession(session.Id)">Начать</button>
                                    break;
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private string searchTerm = string.Empty;
    private List<TestSession>? allSessions;
    private List<TestSession>? filteredSessions;

    public enum SessionStatus { NotStarted, Completed }

    public class TestSession
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public SessionStatus Status { get; set; }
    }

    protected override void OnInitialized()
    {
        LoadSampleData();
        FilterSessions();
    }

    private void LoadSampleData()
    {
        allSessions = new List<TestSession>
        {
            new TestSession { Id = 1, Name = "Сессия0001-группа010203", Status = SessionStatus.Completed},
            new TestSession { Id = 2, Name = "Сессия0002-группа010203", Status = SessionStatus.NotStarted},
            new TestSession { Id = 3, Name = "Сессия0003-группа010203", Status = SessionStatus.NotStarted},
        };
    }

    private void FilterSessions()
    {
        if (allSessions == null) return;

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredSessions = allSessions;
        }
        else
        {
            filteredSessions = allSessions
                .Where(s => s.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void ShowResults(int sessionId)
    {
        Console.WriteLine($"Показать результаты для сессии {sessionId}");
    }

    private void StartSession(int sessionId)
    {
        Console.WriteLine($"Начать сессию {sessionId}");
        NavigationManager.NavigateTo($"/pre-test/{sessionId}");
    }
}