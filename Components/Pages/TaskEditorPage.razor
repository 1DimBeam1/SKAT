@page "/task-editor"
@page "/task-editor/{TaskId:int}"
@inject NavigationManager NavigationManager
@inject AlgorithmApiService AlgorithmService
@rendermode InteractiveServer

@using SKAT_Interface.Services

<PageTitle>Редактор Задания</PageTitle>

<AutoGenerationOptionsModal IsVisible="showAutoGenerateModal"
InputVariablesForGeneration="GetInputVariableNames()"
OnClose="CloseAutoGenerateModal"
OnGenerate="HandleAutoGeneration" />

@if (showMessageModal)
{
    <div class="modal-overlay" @onclick="CloseMessageModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h4>@messageModalTitle</h4>
            <p>@messageModalContent</p>
            <div class="modal-actions">
                @if (isConfirmation)
                {
                    <button class="modal-btn btn-secondary" @onclick="CloseMessageModal">Отмена</button>
                    @if (!isDeletionModal)
                    {
                        <button class="modal-btn btn-primary" @onclick="ConfirmAction">Подтвердить</button>
                    }
                    else
                    {
                        <button class="modal-btn btn-danger" @onclick="ConfirmAction">Удалить</button>
                    }
                }
                else
                {
                    <button class="modal-btn btn-primary" @onclick="CloseMessageModal">OK</button>
                }
            </div>
        </div>
    </div>
}

<div class="task-editor-container">
    <div class="task-editor-header-controls">
        <button class="btn-back" @onclick="NavigateBack">← Назад</button>
        @if (TaskId.HasValue)
        {
            <button class="btn-delete" @onclick="ConfirmDeleteTest">Удалить тест</button>
        }
    </div>

    <div class="task-editor-main-content">
        <!-- Левая колонка -->
        <div class="task-editor-left-column">
            <div class="column-header">Задание</div>
            <div class="form-section">
                <label for="taskText">Текст задания:</label>
                <textarea id="taskText" @bind="taskDescription" rows="8"></textarea>
            </div>
            <div class="algorithm-section">
                <label for="algorithmSelect">Алгоритм:</label>
                <div class="select-wrapper">
                    <select id="algorithmSelect" @bind="selectedAlgorithmId">
                        <option value="0">Выберите алгоритм</option>
                        @foreach (var algo in algorithms)
                        {
                            <option value="@algo.AlgoId">@algo.AlgorithmName</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Правая колонка -->
        <div class="task-editor-right-column">
            <div class="column-header">Параметры</div>
            <div class="form-section">
                <label>Входные значения:</label>
                @if (selectedAlgorithmId > 0 && inputVariables.Any())
                {
                    foreach (var variable in inputVariables)
                    {
                        <div class="input-variable">
                            <label for="@($"var_{variable.VarName}")">@variable.VarName (@variable.VarType):</label>
                            <input type="text" id="@($"var_{variable.VarName}")" @bind="variable.VarValue" placeholder="Например: 1,2,3" />
                        </div>
                    }
                }
                else
                {
                    <p>Выберите алгоритм, чтобы увидеть переменные.</p>
                }
            </div>
            <div class="form-section">
                <label for="taskTitle">Название задания:</label>
                <input type="text" id="taskTitle" @bind="taskName" />
            </div>
            <div class="action-buttons-group">
                @if (TaskId.HasValue)
                {
                    <button class="btn-action btn-auto-generate" @onclick="OpenAutoGenerateModal">Автоматическая генерация</button>
                }
                <div class="stacked-buttons">
                    <button class="btn-action btn-create-task" @onclick="ConfirmSaveTask">Сохранить задание</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? TaskId { get; set; }

    private string taskDescription = "";
    private string taskName = "";
    private List<AlgorithmListItemClientDto> algorithms = new();
    private List<InputVariable> inputVariables = new();
    private List<InputVariable> originalInputVariables = new(); // Исходные переменные теста
    private int? originalAlgorithmId; // Исходный алгоритм теста
    private bool isInitialLoading = false;

    private int _selectedAlgorithmId = 0;
    private int selectedAlgorithmId
    {
        get => _selectedAlgorithmId;
        set
        {
            if (_selectedAlgorithmId != value)
            {
                _selectedAlgorithmId = value;
                _ = OnAlgorithmChanged(value); // Асинхронный вызов
            }
        }
    }

    private bool showMessageModal = false;
    private string messageModalTitle = "";
    private string messageModalContent = "";
    private bool isConfirmation = false;
    private Func<Task>? confirmationAction;

    private bool showAutoGenerateModal = false;
    private bool isDeletionModal = false;

    // Модель для входных переменных
    private class InputVariable
    {
        public string VarName { get; set; } = "";
        public string VarType { get; set; } = "";
        public string VarValue { get; set; } = "";
        public int LineNumber { get; set; } = 0; // Номер строки из editor_bundle
    }

    protected override async Task OnInitializedAsync()
    {
        var algoList = await AlgorithmService.GetAlgorithmsListAsync();
        if (algoList != null)
        {
            algorithms = algoList.ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (isInitialLoading) return; // Предотвращаем повторный вызов, если он уже идет

        isInitialLoading = true;

        if (TaskId.HasValue)
        {
            var testDetails = await AlgorithmService.GetTestDetailsAsync(TaskId.Value);
            if (testDetails != null)
            {
                taskDescription = testDetails.Test.Description ?? "";
                taskName = testDetails.Test.TestName ?? "";

                originalAlgorithmId = testDetails.Test.AlgoId;

                // Загружаем входные переменные теста
                originalInputVariables = testDetails.InputTestData.Select(itd => new InputVariable
                    { VarName = itd.VarName, VarType = itd.VarType, VarValue = itd.VarValue, LineNumber = itd.LineNumber })
                    .ToList();

                // Клонируем их в рабочую коллекцию
                inputVariables = originalInputVariables.Select(v => new InputVariable
                    { VarName = v.VarName, VarType = v.VarType, VarValue = v.VarValue, LineNumber = v.LineNumber })
                    .ToList();

                // Устанавливаем _selectedAlgorithmId НАПРЯМУЮ, чтобы не вызывать сеттер и OnAlgorithmChanged
                _selectedAlgorithmId = testDetails.Test.AlgoId;
            }
        }
        else // Режим создания нового задания
        {
            taskDescription = "";
            taskName = "";
            _selectedAlgorithmId = 0; // Устанавливаем напрямую
            originalAlgorithmId = null;
            inputVariables.Clear();
            originalInputVariables.Clear();
        }

        isInitialLoading = false;
        StateHasChanged(); // Обновляем UI после загрузки
    }

    private async Task OnAlgorithmChanged(int newAlgorithmId)
    {
        // Если идет первоначальная загрузка, то не делаем ничего.
        // OnParametersSetAsync уже позаботился о загрузке правильных переменных.
        if (isInitialLoading)
        {
            return;
        }

        // Этот код теперь будет выполняться ТОЛЬКО при смене алгоритма пользователем в UI
        if (newAlgorithmId > 0)
        {
            var bundle = await AlgorithmService.GetAlgorithmEditorBundleAsync(newAlgorithmId);
            if (bundle != null)
            {
                var step0Vars = bundle.AllConfiguredSteps
                    .Where(s => s.StepNumber == 0)
                    .SelectMany(s => s.Variables.Select(v => new { VarName = v, VarType = s.VarType, LineNumber = s.LineNumber })) // Разворачиваем переменные
                    .ToList();

                // Создаем новый список входных переменных на основе шаблона алгоритма
                var newVariables = step0Vars.Select(s => new InputVariable
                    {
                        VarName = s.VarName ?? "",
                        VarType = s.VarType ?? "Неизвестно",
                        VarValue = "", // Значение по умолчанию пустое
                        LineNumber = s.LineNumber
                    }).ToList();

                // Если пользователь переключился на старый алгоритм, восстановим значения, которые он вводил
                if (TaskId.HasValue && newAlgorithmId == originalAlgorithmId)
                {
                    foreach (var originalVar in originalInputVariables)
                    {
                        var variable = newVariables.FirstOrDefault(v => v.VarName == originalVar.VarName);
                        if (variable != null)
                        {
                            variable.VarValue = originalVar.VarValue;
                        }
                    }
                }

                inputVariables = newVariables; // Заменяем список
            }
            else
            {
                inputVariables.Clear();
            }
        }
        else
        {
            inputVariables.Clear();
        }
        StateHasChanged();
    }


    private void ConfirmSaveTask()
    {
        if (string.IsNullOrWhiteSpace(taskName) || string.IsNullOrWhiteSpace(taskDescription) || selectedAlgorithmId <= 0)
        {
            ShowMessageModal("Ошибка", "Все поля (название, описание, алгоритм) должны быть заполнены.", false);
            return;
        }

        if (inputVariables.Any(v => string.IsNullOrWhiteSpace(v.VarValue)))
        {
            ShowMessageModal("Ошибка", "Все поля значений переменных должны быть заполнены.", false);
            return;
        }

        ShowMessageModal("Подтверждение", "Вы уверены, что хотите сохранить задание?", true, HandleSaveTask); 
    }

    private async Task HandleSaveTask()
    {
        var test = new TestDto
            {
                TestId = TaskId ?? 0,
                AlgoId = selectedAlgorithmId,
                Description = taskDescription,
                TestName = taskName
            };

        var inputData = inputVariables.Select(v => new InputTestDataDto
            {
                TestId = TaskId ?? 0,
                VarName = v.VarName,
                VarValue = v.VarValue,
                VarType = v.VarType,
                LineNumber = v.LineNumber
            }).ToList();

        bool success = false;
        if (TaskId.HasValue)
        {
            // Проверяем, изменился ли алгоритм
            bool algorithmChanged = selectedAlgorithmId != originalAlgorithmId;

            // Проверяем, изменились ли переменные или их значения
            bool variablesChanged = !AreVariablesEqual(originalInputVariables, inputVariables);

            if (!algorithmChanged && !variablesChanged)
            {
                // Обновляем только название и описание
                success = await AlgorithmService.CreateHelperAsync(TaskId.Value, test);
            }
            else
            {
                // Удаляем старый тест
                await AlgorithmService.DeleteTestAsync(TaskId.Value);
                // Создаем новый тест
                var updates = inputVariables.Select(v => new VariableUpdateDto
                    {
                        LineNumber = v.LineNumber,
                        VariableName = v.VarName,
                        Value = v.VarValue
                    }).ToList();

                var createdTestId = await AlgorithmService.CreateTestWithValuesAsync(selectedAlgorithmId, updates);
                if (createdTestId.HasValue)
                {
                    test.TestId = createdTestId.Value;
                    success = await AlgorithmService.CreateHelperAsync(createdTestId.Value, test);
                    if (success)
                    {
                        success = await AlgorithmService.ModifyTestAsync(selectedAlgorithmId, createdTestId.Value);
                    }
                }
            }
        }
        else
        {
            // Создаем список VariableUpdateDto из inputVariables
            var updates = inputVariables.Select(v => new VariableUpdateDto
                {
                    LineNumber = v.LineNumber,
                    VariableName = v.VarName,
                    Value = v.VarValue
                }).ToList();

            // Создаем тест с помощью update-values/{codeId}
            var createdTestId = await AlgorithmService.CreateTestWithValuesAsync(selectedAlgorithmId, updates);
            if (createdTestId.HasValue)
            {
                // Обновляем поля теста (имя и описание) и модификация
                test.TestId = createdTestId.Value;
                success = await AlgorithmService.CreateHelperAsync(createdTestId.Value, test);
                if (success)
                {
                    success = await AlgorithmService.ModifyTestAsync(selectedAlgorithmId, createdTestId.Value);
                };

            }
        }

        if (success)
        {
            ShowMessageModal("Успех", "Задание успешно сохранено!", false);
            if (!TaskId.HasValue) NavigateBack();
        }
        else
        {
            ShowMessageModal("Ошибка", "Ошибка при сохранении задания.", false);
        }
    }

    private bool AreVariablesEqual(List<InputVariable> original, List<InputVariable> current)
    {
        if (original.Count != current.Count) return false;
        for (int i = 0; i < original.Count; i++)
        {
            if (original[i].VarName != current[i].VarName ||
                original[i].VarType != current[i].VarType ||
                original[i].VarValue != current[i].VarValue ||
                original[i].LineNumber != current[i].LineNumber)
            {
                return false;
            }
        }
        return true;
    }

    private void ConfirmDeleteTest()
    {
        isDeletionModal = true;
        ShowMessageModal("Подтверждение", "Вы уверены, что хотите удалить задание?", true, HandleDeleteTask);
    }

    private async Task HandleDeleteTask()
    {
        isDeletionModal = false;
        var success = await AlgorithmService.DeleteTestAsync(TaskId.Value);
        if (success)
        {
            ShowMessageModal("Успех", "Тест успешно удален.", false);
            NavigateBack();
        }
        else
        {
            ShowMessageModal("Ошибка", "Ошибка при удалении теста.", false);
        }
    }

    private void ShowMessageModal(string title, string content, bool isConfirmationModal, Func<Task>? action = null)
    {
        messageModalTitle = title;
        messageModalContent = content;
        isConfirmation = isConfirmationModal;
        confirmationAction = action;
        showMessageModal = true;
    }

    private void CloseMessageModal()
    {
        showMessageModal = false;
        isDeletionModal = false;
    }

    private async Task ConfirmAction()
    {
        if (confirmationAction != null)
        {
            await confirmationAction();
        }
        CloseMessageModal();
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/task-management-editor");
    }
    private void OpenAutoGenerateModal()
    {
        showAutoGenerateModal = true;
    }

    private void CloseAutoGenerateModal()
    {
        showAutoGenerateModal = false;
    }

    private void HandleAutoGeneration(AutoGenerationOptionsModal.AutoGenerationConfig config)
    {
        ShowMessageModal("Информация", "Автогенерация пока не реализована.", false);
    }

    private List<string> GetInputVariableNames()
    {
        return inputVariables.Select(v => v.VarName).ToList();
    }
}