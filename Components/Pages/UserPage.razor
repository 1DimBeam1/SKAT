@page "/user"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
<link href="css/UserPageCSS.css" rel="stylesheet" />
<PageTitle>Мои сессии</PageTitle> @* Пример другого заголовка *@

<div class="user-main-container"> @* Можно использовать те же классы, если CSS будет общим, или свои *@
    <div class="user-main-content">
        <div class="search-bar">
            <input type="text" placeholder="Поиск моей сессии..." @bind="searchTerm" @bind:event="oninput" />
        </div>
        <div class="session-list">
            @if (filteredSessions == null)
            {
                <p><em>Загрузка ваших сессий...</em></p>
            }
            else if (!filteredSessions.Any())
            {
                <p><em>У вас нет доступных сессий.</em></p>
            }
            else
            {
                @foreach (var session in filteredSessions)
                {
                    <div class="session-item">
                        <div class="session-name">@session.Name</div>
                        <div class="session-action">
                            @switch (session.Status)
                            {
                                case SessionStatus.Completed:
                                    <button class="btn-results" @onclick="() => ShowResults(session.Id)">Результаты</button>
                                    break;
                                case SessionStatus.InProgress:
                                    <button class="btn-continue" @onclick="() => ContinueSession(session.Id)">Продолжить</button>
                                    break;
                                case SessionStatus.NotStarted:
                                    <button class="btn-start" @onclick="() => StartSession(session.Id)">Начать</button>
                                    break;
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private string searchTerm = string.Empty;
    private List<TestSession>? allSessions; // Могут быть другие данные для пользователя
    private List<TestSession>? filteredSessions;

    // Enum и класс TestSession можно вынести в общее место, если они идентичны
    public enum SessionStatus { NotStarted, InProgress, Completed }

    public class TestSession
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public SessionStatus Status { get; set; }
    }

    protected override void OnInitialized()
    {
        LoadUserSampleData(); // Метод загрузки данных для пользователя
        FilterSessions();
    }

    private void LoadUserSampleData()
    {
        // Здесь должны загружаться данные, специфичные для пользователя
        allSessions = new List<TestSession>
        {
            new TestSession { Id = 101, Name = "Моя сессия А - группа User001", Status = SessionStatus.Completed },
            new TestSession { Id = 102, Name = "Моя сессия Б - группа User001", Status = SessionStatus.NotStarted },
        };
    }

    private void FilterSessions()
    {
        if (allSessions == null) return;

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredSessions = allSessions;
        }
        else
        {
            filteredSessions = allSessions
                .Where(s => s.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    // Методы могут быть другими для пользователя
    private void ShowResults(int sessionId)
    {
        Console.WriteLine($"Показать результаты для моей сессии {sessionId}");
        // Логика пользователя
    }

    private void ContinueSession(int sessionId)
    {
        Console.WriteLine($"Продолжить мою сессию {sessionId}");
        // Логика пользователя
    }

    private void StartSession(int sessionId)
    {
        Console.WriteLine($"Начать мою сессию {sessionId}");
        // Логика пользователя
    }
}