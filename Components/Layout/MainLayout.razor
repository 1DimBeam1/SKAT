@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@implements IDisposable
<div class="page @(IsActualTestPageActive ? "full-screen-mode" : "")">
    @if (!IsActualTestPageActive)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main>
        @if (IsActualTestPageActive)
        {
            <div class="top-row-custom-header px-3">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="sessions">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Главная страница
                    </NavLink>
                </div>
            </div>
        }
        else
        {
            @* Если у вас была верхняя панель (top-row) отдельно от NavMenu, она может быть здесь *@
            @* Например, <div class="top-row px-4"> ... </div> *@
            @* Но если top-row является частью NavMenu (как в стандартном шаблоне), *@
            @* то он скроется вместе с NavMenu, и этот блок else не нужен. *@
        }

        <article class="content @(IsActualTestPageActive ? "px-0 py-0" : "px-4")">
            @Body
        </article>

    </main>
</div>

@* <div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div> *@

@code {
    private bool IsActualTestPageActive = false;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        UpdateLayoutForCurrentPage(NavigationManager.Uri);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateLayoutForCurrentPage(e.Location);
    }

    private void UpdateLayoutForCurrentPage(string currentUriAbsolute)
    {
        var currentPath = new Uri(currentUriAbsolute).AbsolutePath;
        bool newState = currentPath.StartsWith("/actual-test/", StringComparison.OrdinalIgnoreCase);

        if (newState != IsActualTestPageActive)
        {
            IsActualTestPageActive = newState;
            InvokeAsync(StateHasChanged); // Обновляем UI, если состояние изменилось
        }
    }

    private void NavigateToHome()
    {
        NavigationManager.NavigateTo("sessions");
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}